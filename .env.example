# ==============================================================================
# ReachOut – Environment Configuration Template
# Copy this file to .env.local and configure your credentials
# ==============================================================================

# Supabase PostgreSQL & Auth (Obtained from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Application Base URL (Used for CSRF validation & webhook resolution)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twilio SMS & Voice Gateway (Server-side credentials only - NEVER exposed to client)
# Leave blank to enable ReachOut's built-in intelligent gateway simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

