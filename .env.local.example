# ReachOut – Environment Variables
# Copy this file to .env.local and replace with your real Supabase credentials from your Supabase Dashboard

# Supabase Settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Twilio (For Phase 3 SMS Gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

